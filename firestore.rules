rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function nickname(key) { return key is string && key.matches('^[a-z0-9_]{3,16}$'); }
    match /players/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && nickname(key)
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /scores/{id} {
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 10;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['uid', 'nickname', 'normalizedNickname', 'totalDiffMs', 'itemCount', 'difficulty', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'normalizedNickname', 'totalDiffMs', 'itemCount', 'difficulty', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 3 && request.resource.data.nickname.size() <= 32
        && nickname(request.resource.data.normalizedNickname)
        && get(/databases/$(database)/documents/players/$(request.resource.data.normalizedNickname)).data.uid == request.auth.uid
        && request.resource.data.totalDiffMs is int
        && request.resource.data.totalDiffMs >= 0 && request.resource.data.totalDiffMs <= 86400000
        && request.resource.data.itemCount is int
        && request.resource.data.itemCount >= 1 && request.resource.data.itemCount <= 100
        && request.resource.data.difficulty in ['easy', 'normal', 'hard']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
